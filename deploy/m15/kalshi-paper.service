[Unit]
Description=Paper tests: wide-spread market making + parlay quote requests (GET requests only, never trades)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kalshi
WorkingDirectory=/opt/kalshi-m15/app
# Uses GITHUB_TOKEN (status upload) and the Kalshi key for READ-ONLY signed GETs (quote requests);
# wxbot/paperlab.py has no order code and wraps the client so only GET is possible.
EnvironmentFile=/etc/kalshi-m15/env
ExecStart=/opt/kalshi-m15/venv/bin/python bot.py paperlab -v
Environment=PAPERLAB_DIR=/var/lib/kalshi-paper
StateDirectory=kalshi-paper
Restart=always
RestartSec=60
Nice=10
CPUQuota=10%
MemoryMax=300M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
