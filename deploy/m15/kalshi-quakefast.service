[Unit]
Description=Fast quake YES: quake feeds vs Kalshi quake markets (paper log + small REAL test, quakefast_control.json)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kalshi
WorkingDirectory=/opt/kalshi-m15/app
# Reads the Kalshi key (KALSHI_API_KEY_ID + KALSHI_PRIVATE_KEY_FILE, server-only, never in the
# repo) into memory, then drops it from the environment. Real orders only while
# quakefast_control.json on main says live (and TRADING_MODE isn't off). QUAKEFAST_REAL=0 = paper only.
EnvironmentFile=/etc/kalshi-m15/env
ExecStart=/opt/kalshi-m15/venv/bin/python -m wxbot.quakefast
Environment=QUAKEFAST_DIR=/var/lib/kalshi-quakefast
StateDirectory=kalshi-quakefast
Restart=always
RestartSec=60
Nice=10
CPUQuota=20%
MemoryMax=250M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
