[Unit]
Description=PAPER test: fast quake feeds vs Kalshi quake markets (logs + paper fills only, never trades)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kalshi
WorkingDirectory=/opt/kalshi-m15/app
# Needs only GITHUB_TOKEN from the env file (uploads); quakefast.main() drops every other
# variable (Kalshi key, ntfy topic, API keys) before doing anything.
EnvironmentFile=/etc/kalshi-m15/env
ExecStart=/opt/kalshi-m15/venv/bin/python -m wxbot.quakefast
Environment=QUAKEFAST_DIR=/var/lib/kalshi-quakefast
StateDirectory=kalshi-quakefast
Restart=always
RestartSec=60
Nice=10
CPUQuota=20%
MemoryMax=250M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
