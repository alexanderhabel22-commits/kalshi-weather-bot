[Unit]
Description=Shipping release-window watcher (PAPER ONLY: PortWatch Tuesday release vs Kalshi order books)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kalshi
WorkingDirectory=/opt/kalshi-m15/app
# GET requests only; never places orders. The env file is read for GITHUB_TOKEN (status upload);
# the Kalshi key and other secrets are dropped from the environment at start.
EnvironmentFile=/etc/kalshi-m15/env
ExecStart=/opt/kalshi-m15/venv/bin/python -m wxbot.shiprelease
Environment=SHIPREL_DIR=/var/lib/kalshi-shiprel
StateDirectory=kalshi-shiprel
Restart=always
RestartSec=60
Nice=10
CPUQuota=10%
MemoryMax=150M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
