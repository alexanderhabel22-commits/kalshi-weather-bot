[Unit]
Description=AI ops watcher for the Kalshi bots (one pass)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kalshi
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/kalshi-m15/app
EnvironmentFile=/etc/kalshi-m15/env
ExecStart=/opt/kalshi-m15/venv/bin/python bot.py watch -v
TimeoutStartSec=300
NoNewPrivileges=true
